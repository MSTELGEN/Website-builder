# Kit (formerly ConvertKit) configuration
# Get your Form ID from Kit > Forms > [Your Form] > Settings > Form ID
NEXT_PUBLIC_KIT_FORM_ID=your_kit_form_id_here

# Kit API Secret (server-side only — never expose to client)
# Found in Kit > Account Settings > Developer > API Secret
KIT_API_SECRET=your_kit_api_secret_here

# Optional: Kit waitlist tag ID (tag subscribers who click the waitlist CTA)
# Create a tag "sleep-reset-waitlist" in Kit > Subscribers > Tags, then paste its ID
NEXT_PUBLIC_KIT_WAITLIST_TAG_ID=your_waitlist_tag_id_here
